          "id": "15eec0e4-2a6a-420b-a4db-fee3aefc4637",
          "name": "Zapier Get Authentications",
          "request": {
            "name": "Zapier Get Authentications",
            "description": {
              "content": "Fetch the available Authentications for the provided App. This will only return Authentications that are owned by the user and not those that are shared with them, since it's not possible to create Zaps with Authentications you don't own.\n\n#### When using OAuth\n\nThis endpoint requires the `connection:read` OAuth scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "authentications"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "app",
                  "value": "<uuid>",
                  "description": "(Required) A canonical App ID, as provided by the `/apps` endpoint."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Used for paginating results. Specifies the maximum number of items to return per page. If this value is not set, it defaults to 10."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Used for paginating results. Specifies the offset to use."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "profile zap zap:write authentication authentication:write zap:runs action:run zap:all"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://zapier.com/oauth/token/"
                },
                {
                  "key": "accessTokenUrl",
